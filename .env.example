# Offload — environment variable template
# Copy to .env and fill in. Production values live in Railway (api, ml-service),
# EAS (mobile), and Vercel (web) — not here.
#
# This file is generated from the actual process.env reads in the source. If you
# add a new env var, add it here too.

# ─── backend/api ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Postgres. DATABASE_URL wins when set (this is what Railway provides);
# the discrete POSTGRES_* vars are the local-dev fallback.
DATABASE_URL=postgresql://hub_user:hub_dev_password@localhost:5432/thehub_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hub_user
POSTGRES_PASSWORD=hub_dev_password
POSTGRES_DB=thehub_dev

# Connection pool (all optional — defaults are in src/db/connection.ts)
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT=
DB_POOL_CONNECTION_TIMEOUT=

# Vector store — Weaviate Cloud in production
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Speech
DEEPGRAM_API_KEY=                          # live transcription, streamed from the device
OPENAI_API_KEY=
GPT4O_TRANSCRIBE_MODEL=gpt-4o-transcribe   # final saved transcript
WHISPER_MODEL=whisper-1                    # legacy transcription path
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM for RAG answers and synthesis.
# ANTHROPIC_API_KEY present → Claude; otherwise falls back to OpenAI.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
SPAR_MODEL=gpt-4o

# Python parsing service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=                        # sent as X-Service-Key; must match ml-service

# Place resolution — OpenStreetMap needs no key; Google is the fallback provider
GOOGLE_PLACES_API_KEY=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Object storage (S3-compatible; MinIO client SDK pointed at AWS S3 in prod).
# Note: the live voice path does not currently persist audio — this is used by
# the legacy voice-session flow and by account deletion.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=thehub-dev
S3_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006

# Feature flags
ENABLE_RELATIONSHIPS=
ENABLE_LONG_TERM_SYNTHESIS=

# ─── backend/ml-service ───────────────────────────────────────────────────────

# PORT, ALLOWED_ORIGINS, OPENAI_API_KEY, ANTHROPIC_API_KEY, ML_SERVICE_API_KEY
# as above. Additionally:
LLM_MODEL=gpt-4o                  # startswith "claude" switches to Anthropic

# ─── mobile ───────────────────────────────────────────────────────────────────

# Set per build profile in mobile/eas.json, not in a .env file.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
